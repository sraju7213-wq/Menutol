{
  "builds": [
    {
      "use": "@vercel/node",
      "src": "api/**/*.js"
    },
    {
      "use": "@vercel/static",
      "src": "public/index.html"
    },
    {
      "use": "@vercel/static",
      "src": "public/counter.html"
    },
    {
      "use": "@vercel/static",
      "src": "public/script.js"
    },
    {
      "use": "@vercel/static",
      "src": "public/styles.css"
    },
    {
      "use": "@vercel/static",
      "src": "public/scene3d.js"
    },
    {
      "use": "@vercel/static",
      "src": "public/dist/**/*"
    },
    {
      "use": "@vercel/static",
      "src": "public/libs/**/*"
    }
  ],
  "routes": [
    {
      "src": "/api/orders",
      "dest": "/api/orders.js"
    },
    {
      "src": "/api/create-order",
      "dest": "/api/create-order.js"
    },
    {
      "src": "/api/update-status",
      "dest": "/api/update-status.js"
    },
    {
      "src": "/counter",
      "dest": "/public/counter.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
